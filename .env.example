# Set to the actual invitation URL after deployment for share preview image URLs.
NEXT_PUBLIC_SITE_URL=

# Optional overrides for the configured, scoped RSVP Edge Function.
# Leave blank to use src/lib/rsvp-config.ts and the dedicated fatin_arfan_rsvps table.
# RSVP_API_KEY is an invitation-scoped access key, not a project database API key.
RSVP_API_URL=
RSVP_API_KEY=
